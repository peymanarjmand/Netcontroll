<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="نصب Netcontroll" Width="830" Height="610" MinWidth="390" MinHeight="330" WindowStartupLocation="CenterScreen"
 FontFamily="Segoe UI Variable Text, Segoe UI, Tahoma" FontSize="16" Language="fa-IR" UseLayoutRounding="True" TextOptions.TextFormattingMode="Display">
 <Grid Background="{DynamicResource Canvas}"><Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
   <StackPanel>
    <Border Padding="27,22" BorderBrush="#3E3C55" BorderThickness="0,0,0,1">
     <Border.Background><LinearGradientBrush StartPoint="0,0" EndPoint="1,1"><GradientStop Color="#262E42" Offset="0"/><GradientStop Color="#312945" Offset=".62"/><GradientStop Color="#222536" Offset="1"/></LinearGradientBrush></Border.Background>
     <Grid FlowDirection="RightToLeft"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
      <StackPanel>
       <StackPanel Orientation="Horizontal" VerticalAlignment="Center"><Border Style="{DynamicResource MarkTile}"><Path Data="{DynamicResource Logo}" Width="25" Height="25" Stretch="Uniform" Stroke="#B9A8FF" StrokeThickness="2.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" HorizontalAlignment="Center" VerticalAlignment="Center" FlowDirection="LeftToRight"/></Border>
        <TextBlock Text="Netcontroll" FontSize="21" FontWeight="SemiBold" Margin="10,0" VerticalAlignment="Center"/>
        <TextBlock x:Name="VersionLabel" Foreground="#C5BEE5" FontSize="14" VerticalAlignment="Center" FlowDirection="LeftToRight"/>
       </StackPanel>
       <TextBlock x:Name="Heading" Text="نصب Netcontroll" FontSize="30" FontWeight="Bold" Margin="0,15,0,3" TextWrapping="Wrap"/>
       <TextBlock x:Name="Intro" Text="محل نصب و میان‌بر برنامه را بررسی کنید." Foreground="{DynamicResource Muted}" FontSize="15" TextWrapping="Wrap"/>
      </StackPanel>
      <Viewbox x:Name="RouteArt" Grid.Column="1" Width="185" Height="100" VerticalAlignment="Center" FlowDirection="LeftToRight" IsHitTestVisible="False">
       <Canvas Width="190" Height="94">
        <Path Stroke="#64607F" StrokeThickness="1" Data="M4,22 L185,22 M4,48 L185,48 M4,74 L185,74" StrokeDashArray="2,6"/>
        <Path Stroke="#B9A8FF" StrokeThickness="3" StrokeLineJoin="Round" Data="M10,74 L54,74 L82,46 L126,46 L151,21 L179,21"/>
        <Path Stroke="#80D9C1" StrokeThickness="3" StrokeLineJoin="Round" Data="M10,22 L42,22 L68,48 L96,48 L122,74 L177,74"/>
        <Ellipse Canvas.Left="5" Canvas.Top="17" Width="10" Height="10" Fill="#213A36" Stroke="#80D9C1" StrokeThickness="2"/>
        <Ellipse Canvas.Left="174" Canvas.Top="16" Width="10" Height="10" Fill="#B9A8FF"/>
        <Ellipse Canvas.Left="5" Canvas.Top="69" Width="10" Height="10" Fill="#302A43" Stroke="#B9A8FF" StrokeThickness="2"/>
        <Ellipse Canvas.Left="172" Canvas.Top="69" Width="10" Height="10" Fill="#80D9C1"/>
       </Canvas>
      </Viewbox>
     </Grid>
    </Border>
    <StackPanel Margin="27,19" FlowDirection="RightToLeft">
     <Border Background="{DynamicResource Panel}" BorderBrush="{DynamicResource Stroke}" BorderThickness="1" CornerRadius="13" Padding="18,14">
      <StackPanel>
       <TextBlock Text="پوشهٔ نصب" FontWeight="SemiBold" FontSize="16" Margin="0,0,0,8"/>
       <TextBox x:Name="InstallLocation" FlowDirection="LeftToRight" IsReadOnly="True" AutomationProperties.Name="پوشهٔ نصب" TextWrapping="Wrap"/>
       <CheckBox x:Name="DesktopShortcut" Content="میان‌بر روی دسکتاپ بساز" IsChecked="True" Margin="1,16,1,4"/>
      </StackPanel>
     </Border>
     <TextBlock x:Name="SetupStatus" Foreground="{DynamicResource Muted}" FontSize="15" TextWrapping="Wrap" Margin="2,13,2,0" AutomationProperties.LiveSetting="Polite"/>
    </StackPanel>
   </StackPanel>
  </ScrollViewer>
  <Border Grid.Row="1" Background="#191C28" BorderBrush="{DynamicResource Stroke}" BorderThickness="0,1,0,0" Padding="17,12">
   <WrapPanel FlowDirection="RightToLeft" HorizontalAlignment="Right">
    <Button x:Name="PrimaryAction" Style="{DynamicResource Primary}" IsDefault="True" Content="نصب برنامه" MinWidth="189" MinHeight="50" Padding="22,10" FontSize="17"/>
    <Button x:Name="CloseAction" Content="بستن" MinWidth="88" MinHeight="50" Padding="14,10" FontSize="15"/>
   </WrapPanel>
  </Border>
 </Grid>
</Window>
