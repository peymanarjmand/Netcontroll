{
  "manifest_version": 3, "name": "Netcontroll · مسیر دامنه‌ها", "version": "1.1.1",
  "description": "Connect this Chrome profile to your local Netcontroll routing rules.",
  "permissions": ["proxy", "storage", "alarms"],
