<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <SolidColorBrush x:Key="Canvas" Color="#18191E"/>
  <SolidColorBrush x:Key="Panel" Color="#24252B"/>
  <SolidColorBrush x:Key="Field" Color="#1C1D23"/>
  <SolidColorBrush x:Key="Stroke" Color="#3C3E47"/>
  <SolidColorBrush x:Key="Ink" Color="#F4F4F5"/>
  <SolidColorBrush x:Key="Muted" Color="#B2B4BF"/>
  <SolidColorBrush x:Key="Accent" Color="#F64908"/>
  <SolidColorBrush x:Key="OnAccent" Color="#FFFFFF"/>
  <SolidColorBrush x:Key="Mint" Color="#57D2BD"/>
  <Style TargetType="Button">
    <Setter Property="Background" Value="#28292F"/>
    <Setter Property="Foreground" Value="{StaticResource Ink}"/>
    <Setter Property="BorderBrush" Value="{StaticResource Stroke}"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="FontSize" Value="13"/>
    <Setter Property="Padding" Value="12,7"/>
    <Setter Property="MinHeight" Value="36"/>
    <Setter Property="Margin" Value="3"/>
    <Setter Property="Cursor" Value="Hand"/>
    <Setter Property="HorizontalContentAlignment" Value="Center"/>
    <Setter Property="VerticalContentAlignment" Value="Center"/>
    <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
      <Border x:Name="Surface" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8" Padding="{TemplateBinding Padding}">
        <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center" RecognizesAccessKey="True"/>
      </Border>
      <ControlTemplate.Triggers>
        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Surface" Property="BorderBrush" Value="#F98153"/></Trigger>
        <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Surface" Property="BorderBrush" Value="White"/><Setter TargetName="Surface" Property="BorderThickness" Value="2"/></Trigger>
        <Trigger Property="IsPressed" Value="True"><Setter TargetName="Surface" Property="Opacity" Value=".74"/></Trigger>
        <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Surface" Property="Opacity" Value=".42"/></Trigger>
      </ControlTemplate.Triggers>
    </ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style x:Key="Primary" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
    <Setter Property="Background" Value="{StaticResource Accent}"/><Setter Property="Foreground" Value="{StaticResource OnAccent}"/>
    <Setter Property="BorderBrush" Value="{StaticResource Accent}"/><Setter Property="FontWeight" Value="SemiBold"/>
  </Style>
  <Style TargetType="TextBox">
    <Setter Property="Background" Value="{StaticResource Field}"/><Setter Property="Foreground" Value="{StaticResource Ink}"/>
    <Setter Property="CaretBrush" Value="{StaticResource Ink}"/><Setter Property="SelectionBrush" Value="#78452F"/>
    <Setter Property="BorderBrush" Value="{StaticResource Stroke}"/><Setter Property="BorderThickness" Value="1"/>
    <Setter Property="Padding" Value="11,7"/><Setter Property="FontSize" Value="13"/><Setter Property="MinHeight" Value="36"/>
    <Setter Property="VerticalContentAlignment" Value="Center"/>
    <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="TextBox">
      <Border x:Name="FieldFrame" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8">
        <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}" VerticalAlignment="Center"/>
      </Border>
      <ControlTemplate.Triggers>
        <Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter TargetName="FieldFrame" Property="BorderBrush" Value="{StaticResource Accent}"/></Trigger>
        <Trigger Property="IsEnabled" Value="False"><Setter TargetName="FieldFrame" Property="Opacity" Value=".48"/></Trigger>
      </ControlTemplate.Triggers>
    </ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style TargetType="CheckBox">
    <Setter Property="Foreground" Value="{StaticResource Ink}"/><Setter Property="FontSize" Value="13"/>
    <Setter Property="VerticalContentAlignment" Value="Center"/><Setter Property="Cursor" Value="Hand"/>
    <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="CheckBox">
      <Grid Background="Transparent"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
        <Border x:Name="Box" Width="18" Height="18" Background="{StaticResource Field}" BorderBrush="#757883" BorderThickness="1" CornerRadius="4" VerticalAlignment="Center">
          <Path x:Name="Mark" Visibility="Hidden" Data="M 3,8 L 7,12 L 14,4" Stroke="White" StrokeThickness="2" FlowDirection="LeftToRight"/>
        </Border>
        <ContentPresenter Grid.Column="1" Margin="9,0,9,0" VerticalAlignment="Center" RecognizesAccessKey="True"/>
      </Grid>
      <ControlTemplate.Triggers>
        <Trigger Property="IsChecked" Value="True"><Setter TargetName="Box" Property="Background" Value="{StaticResource Accent}"/><Setter TargetName="Box" Property="BorderBrush" Value="{StaticResource Accent}"/><Setter TargetName="Mark" Property="Visibility" Value="Visible"/></Trigger>
        <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Box" Property="BorderBrush" Value="White"/></Trigger>
        <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value=".45"/></Trigger>
      </ControlTemplate.Triggers>
    </ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style TargetType="RadioButton">
    <Setter Property="Foreground" Value="{StaticResource Muted}"/><Setter Property="FontSize" Value="13"/>
    <Setter Property="Padding" Value="12,8"/><Setter Property="Margin" Value="0,3,6,3"/><Setter Property="Cursor" Value="Hand"/>
    <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="RadioButton">
      <Border x:Name="Choice" Background="#202127" BorderBrush="{StaticResource Stroke}" BorderThickness="1" CornerRadius="8" Padding="{TemplateBinding Padding}">
        <ContentPresenter VerticalAlignment="Center" RecognizesAccessKey="True"/>
      </Border>
      <ControlTemplate.Triggers>
        <Trigger Property="IsChecked" Value="True"><Setter TargetName="Choice" Property="Background" Value="#462821"/><Setter TargetName="Choice" Property="BorderBrush" Value="#BC4F27"/><Setter Property="Foreground" Value="#FF9B73"/></Trigger>
        <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Choice" Property="BorderBrush" Value="White"/></Trigger>
        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Choice" Property="BorderBrush" Value="#F98153"/></Trigger>
      </ControlTemplate.Triggers>
    </ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style TargetType="ScrollBar">
    <Setter Property="Width" Value="9"/><Setter Property="Margin" Value="1"/><Setter Property="Background" Value="Transparent"/>
    <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ScrollBar">
      <Grid Background="Transparent"><Track x:Name="PART_Track" IsDirectionReversed="True" Orientation="{TemplateBinding Orientation}">
        <Track.DecreaseRepeatButton><RepeatButton x:Name="Up" Command="ScrollBar.PageUpCommand" Opacity="0" Focusable="False"/></Track.DecreaseRepeatButton>
        <Track.Thumb><Thumb><Thumb.Template><ControlTemplate TargetType="Thumb"><Border Background="#555861" CornerRadius="3" Margin="2"/></ControlTemplate></Thumb.Template></Thumb></Track.Thumb>
        <Track.IncreaseRepeatButton><RepeatButton x:Name="Down" Command="ScrollBar.PageDownCommand" Opacity="0" Focusable="False"/></Track.IncreaseRepeatButton>
      </Track></Grid>
      <ControlTemplate.Triggers><Trigger Property="Orientation" Value="Horizontal"><Setter TargetName="PART_Track" Property="IsDirectionReversed" Value="False"/><Setter TargetName="Up" Property="Command" Value="ScrollBar.PageLeftCommand"/><Setter TargetName="Down" Property="Command" Value="ScrollBar.PageRightCommand"/></Trigger></ControlTemplate.Triggers>
    </ControlTemplate></Setter.Value></Setter>
    <Style.Triggers><Trigger Property="Orientation" Value="Horizontal"><Setter Property="Width" Value="Auto"/><Setter Property="Height" Value="9"/></Trigger></Style.Triggers>
  </Style>
  <Style TargetType="ToolTip"><Setter Property="Background" Value="#303138"/><Setter Property="Foreground" Value="{StaticResource Ink}"/><Setter Property="BorderBrush" Value="#51535D"/><Setter Property="FontSize" Value="12"/><Setter Property="Padding" Value="10,7"/></Style>
  <Style TargetType="ContextMenu"><Setter Property="Background" Value="#24252B"/><Setter Property="Foreground" Value="{StaticResource Ink}"/><Setter Property="BorderBrush" Value="#51535D"/><Setter Property="Padding" Value="4"/></Style>
  <Style TargetType="MenuItem">
    <Setter Property="FontSize" Value="13"/><Setter Property="Padding" Value="12,8"/>
    <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="MenuItem">
      <Border x:Name="ItemSurface" Background="Transparent" CornerRadius="5" Padding="{TemplateBinding Padding}"><ContentPresenter ContentSource="Header" RecognizesAccessKey="True"/></Border>
      <ControlTemplate.Triggers><Trigger Property="IsHighlighted" Value="True"><Setter TargetName="ItemSurface" Property="Background" Value="#493024"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value=".4"/></Trigger></ControlTemplate.Triggers>
    </ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style x:Key="MarkTile" TargetType="Border"><Setter Property="Width" Value="39"/><Setter Property="Height" Value="39"/><Setter Property="CornerRadius" Value="11"/><Setter Property="Background" Value="#48281E"/><Setter Property="BorderBrush" Value="#8A4227"/><Setter Property="BorderThickness" Value="1"/></Style>
  <Geometry x:Key="Logo">M 3,23 L 3,4 L 22,23 L 22,4</Geometry>
</ResourceDictionary>
