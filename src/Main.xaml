<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Netcontroll" Width="1090" Height="740" MinWidth="920" MinHeight="620" WindowStartupLocation="CenterScreen" FontFamily="Segoe UI,Tahoma" Background="#F4F7F8" Language="fa-IR" UseLayoutRounding="True" TextOptions.TextFormattingMode="Display">
<Window.Resources>
 <SolidColorBrush x:Key="Ink" Color="#172F37"/><SolidColorBrush x:Key="Muted" Color="#526871"/>
 <Style TargetType="Button"><Setter Property="Cursor" Value="Hand"/><Setter Property="Padding" Value="15,8"/><Setter Property="Margin" Value="3"/><Setter Property="FontSize" Value="13"/><Setter Property="Background" Value="#E5EEEF"/><Setter Property="Foreground" Value="{StaticResource Ink}"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="surface" Background="{TemplateBinding Background}" CornerRadius="7" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="True"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="surface" Property="Opacity" Value=".80"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter TargetName="surface" Property="Opacity" Value=".5"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
 <Style TargetType="TextBox"><Setter Property="Padding" Value="10,7"/><Setter Property="FontSize" Value="14"/><Setter Property="BorderBrush" Value="#AFBFC1"/><Setter Property="BorderThickness" Value="1"/><Setter Property="VerticalContentAlignment" Value="Center"/></Style>
</Window.Resources>
<Grid Background="#F4F7F8"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="205"/></Grid.ColumnDefinitions>
<Border Grid.Column="1" Background="#112E35"><DockPanel Margin="16,25" LastChildFill="False">
<StackPanel DockPanel.Dock="Top"><StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,42"><Viewbox Width="29" Height="29"><Canvas Width="32" Height="32"><Path Stroke="#69E4BE" StrokeThickness="4" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Data="M 4,26 L 4,6  L 26,26 L 26,6"/><Ellipse Canvas.Left="22" Canvas.Top="1" Width="8" Height="8" Fill="#69E4BE"/></Canvas></Viewbox><TextBlock Text="Netcontroll" Foreground="White" FontWeight="SemiBold" FontSize="22" Margin="9,0,0,0"/></StackPanel>
<StackPanel x:Name="Nav" FlowDirection="RightToLeft"/></StackPanel>
<StackPanel DockPanel.Dock="Bottom" FlowDirection="RightToLeft"><Border Height="1" Background="#34545B" Margin="0,0,0,12"/><TextBlock Text="توسعه‌دهنده" Foreground="#A4BABC" FontSize="12"/><TextBlock Text="peymanarjmand" Foreground="#E6F3F1" FontSize="14" Margin="0,3,0,0"/></StackPanel></DockPanel></Border>
<Grid Margin="31,26" FlowDirection="RightToLeft"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
<DockPanel><StackPanel><TextBlock x:Name="Title" FontSize="30" FontWeight="Bold" Foreground="{StaticResource Ink}"/><TextBlock x:Name="Subtitle" FontSize="14" Margin="0,4,0,0" TextWrapping="Wrap" Foreground="{StaticResource Muted}"/></StackPanel></DockPanel>
<UniformGrid Grid.Row="1" Columns="2" Margin="0,23,0,13">
<Border Background="#DBF1E9" CornerRadius="12" Padding="17,13" Margin="0,0,0,0"><StackPanel><TextBlock Text="اینترنت عادی" Foreground="#365F50" FontSize="12"/><TextBlock x:Name="Direct" Text="…" FontWeight="SemiBold" FontSize="16" Foreground="#163B30" TextTrimming="CharacterEllipsis"/></StackPanel></Border>
<Border Background="#DEE9F7" CornerRadius="12" Padding="17,13" Margin="10,0,0,0"><StackPanel><TextBlock Text="مسیر VPN" Foreground="#416481" FontSize="12"/><TextBlock x:Name="Vpn" Text="…" FontWeight="SemiBold" FontSize="16" Foreground="#1B405F" TextTrimming="CharacterEllipsis"/></StackPanel></Border>
</UniformGrid>
<WrapPanel x:Name="Actions" Grid.Row="2" Margin="0,0,0,9"/>
<Grid Grid.Row="3" Margin="0,0,0,9"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Text="جستجو" Foreground="{StaticResource Muted}" VerticalAlignment="Center" Margin="2,0,0,0"/><TextBox x:Name="Search" Grid.Column="1" Margin="9,0,0,0" MaxLength="256" AutomationProperties.Name="جستجو"/></Grid>
<ScrollViewer Grid.Row="4" VerticalScrollBarVisibility="Auto"><StackPanel x:Name="Rows"/></ScrollViewer>
<TextBlock Grid.Row="5" x:Name="Status" TextWrapping="Wrap" Margin="2,10,2,0" FontSize="12" Foreground="#365967"/>
</Grid></Grid></Window>
