<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="Netcontroll · کنترل مسیر شبکه" Width="1250" Height="820" MinWidth="760" MinHeight="560" WindowStartupLocation="CenterScreen"
 FontFamily="Segoe UI Variable Text, Segoe UI, Tahoma" FontSize="13" Language="fa-IR" UseLayoutRounding="True" TextOptions.TextFormattingMode="Display">
 <Grid Background="{DynamicResource Canvas}">
  <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
  <Border Grid.Column="1" x:Name="Sidebar" Width="228" Background="#202127" BorderBrush="#41434B" BorderThickness="1,0,0,0">
   <DockPanel LastChildFill="True" Margin="10,18,10,12">
    <StackPanel DockPanel.Dock="Top" Margin="0,0,0,16">
     <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,16">
      <Border Style="{DynamicResource MarkTile}"><Path Data="{DynamicResource Logo}" Width="23" Height="23" Stretch="Uniform" Stroke="#F96A32" StrokeThickness="3" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" HorizontalAlignment="Center" VerticalAlignment="Center" FlowDirection="LeftToRight"/></Border>
      <StackPanel x:Name="BrandName" Margin="9,0,0,0" VerticalAlignment="Center"><TextBlock Text="Netcontroll" Foreground="#FAFAFB" FontSize="21" FontWeight="SemiBold"/><TextBlock Text="NETWORK CONTROL" Foreground="#8F919D" FontSize="9"/></StackPanel>
     </StackPanel>
     <Border x:Name="SideHealth" Background="#2C2726" BorderBrush="#514039" BorderThickness="1" CornerRadius="11" Padding="11,9" FlowDirection="RightToLeft">
      <StackPanel><DockPanel><Ellipse Width="6" Height="6" Fill="#57D2BD" Margin="0,0,7,0"/><TextBlock Text="پراکسی محلی فعال" FontWeight="SemiBold" FontSize="12"/></DockPanel><TextBlock x:Name="SideSummary" Foreground="#B8B6B7" FontSize="11" TextWrapping="Wrap" Margin="0,6,0,0"/></StackPanel>
     </Border>
    </StackPanel>
    <StackPanel x:Name="Credit" DockPanel.Dock="Bottom" Margin="3,12,3,0">
      <Border Height="1" Background="#3C3E47" Margin="0,0,0,10"/>
      <DockPanel FlowDirection="RightToLeft"><TextBlock Text="توسعه‌دهنده" Foreground="#92949F" FontSize="11"/><TextBlock x:Name="Version" Foreground="#92949F" FontSize="11" HorizontalAlignment="Left" FlowDirection="LeftToRight"/></DockPanel>
      <TextBlock x:Name="DeveloperEmail" Text="peymanarjmand308@gmail.com" Foreground="#D4D5DD" FontSize="11" Margin="0,5,0,0" FlowDirection="LeftToRight" TextAlignment="Center" Cursor="Hand" ToolTip="کپی ایمیل توسعه‌دهنده" AutomationProperties.Name="ایمیل توسعه‌دهنده peymanarjmand308@gmail.com"/>
    </StackPanel>
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel x:Name="Nav" FlowDirection="RightToLeft"/></ScrollViewer>
   </DockPanel>
  </Border>
  <Grid FlowDirection="RightToLeft">
   <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
   <Border Background="#202127" BorderBrush="#393B43" BorderThickness="0,0,0,1" Padding="23,15,23,14">
    <DockPanel LastChildFill="True">
     <Border DockPanel.Dock="Left" VerticalAlignment="Center" Background="#1E3532" BorderBrush="#2D5750" BorderThickness="1" CornerRadius="9" Padding="10,6" Margin="10,0,0,0"><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE774;" FontFamily="Segoe MDL2 Assets" Foreground="#57D2BD" FontSize="14" Margin="0,0,6,0"/><TextBlock Text="روی همین دستگاه" Foreground="#8CDACB" FontSize="11"/></StackPanel></Border>
     <StackPanel><TextBlock x:Name="Title" FontSize="22" FontWeight="SemiBold" Foreground="{DynamicResource Ink}"/><TextBlock x:Name="Subtitle" FontSize="12" TextWrapping="Wrap" Margin="0,4,0,0" Foreground="{DynamicResource Muted}"/></StackPanel>
    </DockPanel>
   </Border>
   <Grid x:Name="Body" Grid.Row="1" Margin="21,18,21,12">
    <ScrollViewer x:Name="ContentScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" CanContentScroll="False">
     <StackPanel Margin="2,0,2,0">
      <Border x:Name="OverviewHero" CornerRadius="14" BorderBrush="#654333" BorderThickness="1" Padding="20,18" Margin="0,0,0,14" Visibility="Collapsed">
       <Border.Background><LinearGradientBrush StartPoint="0,1" EndPoint="1,0"><GradientStop Color="#26252A" Offset="0"/><GradientStop Color="#4C2A20" Offset="1"/></LinearGradientBrush></Border.Background>
       <DockPanel>
        <Viewbox DockPanel.Dock="Left" Width="180" Height="112" Margin="16,0,0,0" IsHitTestVisible="False" FlowDirection="LeftToRight">
         <Canvas Width="210" Height="120">
          <Ellipse Width="108" Height="108" Canvas.Left="45" Canvas.Top="6" Stroke="#654133" StrokeThickness="1"/>
          <Ellipse Width="78" Height="78" Canvas.Left="60" Canvas.Top="21" Fill="#432B25"/>
          <Path Data="M32,90 L62,90 L99,60 L145,27 L176,27" Stroke="#FA713D" StrokeThickness="3" StrokeLineJoin="Round"/>
          <Path Data="M99,60 L146,92 L176,92" Stroke="#57D2BD" StrokeThickness="3" StrokeLineJoin="Round"/>
          <Border Canvas.Left="74" Canvas.Top="35" Width="50" Height="50" CornerRadius="14" Background="#F64908"><TextBlock Text="&#xE839;" FontFamily="Segoe MDL2 Assets" FontSize="24" Foreground="White" VerticalAlignment="Center" HorizontalAlignment="Center"/></Border>
          <Border Canvas.Left="164" Canvas.Top="10" Width="34" Height="34" CornerRadius="10" Background="#4E2E23" BorderBrush="#B85C36" BorderThickness="1"><TextBlock Text="&#xEA18;" FontFamily="Segoe MDL2 Assets" FontSize="17" Foreground="#FF9A71" VerticalAlignment="Center" HorizontalAlignment="Center"/></Border>
          <Border Canvas.Left="164" Canvas.Top="75" Width="34" Height="34" CornerRadius="10" Background="#203B36" BorderBrush="#3A8D7E" BorderThickness="1"><TextBlock Text="&#xE701;" FontFamily="Segoe MDL2 Assets" FontSize="17" Foreground="#68D7C1" VerticalAlignment="Center" HorizontalAlignment="Center"/></Border>
          <Ellipse Canvas.Left="19" Canvas.Top="83" Width="14" Height="14" Fill="#24252B" Stroke="#F98153" StrokeThickness="2"/>
         </Canvas>
        </Viewbox>
        <StackPanel VerticalAlignment="Center"><TextBlock Text="اتصال‌ها، با انتخاب شما" Foreground="#FF9467" FontSize="13" FontWeight="SemiBold"/><TextBlock Text="هر مقصد، از مسیر مناسب" FontSize="23" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,7,0,6"/><TextBlock Text="سایت‌های روزمره با اینترنت عادی؛ مرورگر، Codex و Docker با مسیر دلخواه شما." Foreground="#D9C7BF" FontSize="13" TextWrapping="Wrap"/><TextBlock Text="نمای شماتیک مسیرها · وضعیت واقعی در کارت‌های زیر" Foreground="#AD9A91" FontSize="10" Margin="0,10,0,0"/></StackPanel>
       </DockPanel>
      </Border>
      <UniformGrid x:Name="RouteStrip" Columns="2" Margin="-4,0,-4,12">
       <Border Background="#232C2C" BorderBrush="#354B48" BorderThickness="1" CornerRadius="11" Padding="13,12" Margin="4,0"><DockPanel>
        <Border Width="35" Height="35" CornerRadius="10" Background="#243D38" Margin="0,0,10,0" VerticalAlignment="Center"><TextBlock Text="&#xE701;" FontFamily="Segoe MDL2 Assets" FontSize="17" Foreground="#57D2BD" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
        <StackPanel><TextBlock Text="مسیر اینترنت عادی" Foreground="#75D2C0" FontSize="11"/><TextBlock x:Name="Direct" FlowDirection="LeftToRight" TextAlignment="Right" FontSize="12" Foreground="#F2F3F5" TextTrimming="CharacterEllipsis" Margin="0,5,0,0"/></StackPanel>
       </DockPanel></Border>
       <Border Background="#2E2726" BorderBrush="#574035" BorderThickness="1" CornerRadius="11" Padding="13,12" Margin="4,0"><DockPanel>
        <Border Width="35" Height="35" CornerRadius="10" Background="#482C21" Margin="0,0,10,0" VerticalAlignment="Center"><TextBlock Text="&#xEA18;" FontFamily="Segoe MDL2 Assets" FontSize="17" Foreground="#FF8B58" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
        <StackPanel><TextBlock Text="مسیر VPN" Foreground="#FF9A71" FontSize="11"/><TextBlock x:Name="Vpn" FlowDirection="LeftToRight" TextAlignment="Right" FontSize="12" Foreground="#F2F3F5" TextTrimming="CharacterEllipsis" Margin="0,5,0,0"/></StackPanel>
       </DockPanel></Border>
      </UniformGrid>
      <StackPanel x:Name="PolicyPanel"/>
      <WrapPanel x:Name="Actions" Margin="-3,0,-3,10"/>
      <Border x:Name="ChromeStatePanel" CornerRadius="8" Background="#202D2B" Padding="11,8" Margin="0,0,0,10" Visibility="Collapsed"><TextBlock x:Name="ChromeStatus" TextWrapping="Wrap" FontSize="12" Foreground="{DynamicResource Muted}" AutomationProperties.LiveSetting="Polite"/></Border>
      <Border x:Name="SearchPanel" Background="#24252B" CornerRadius="10" BorderBrush="#3C3E47" BorderThickness="1" Padding="9,8" Margin="0,0,0,10">
       <StackPanel>
        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
         <TextBlock Text="&#xE721;" FontFamily="Segoe MDL2 Assets" Foreground="#9497A3" VerticalAlignment="Center" Margin="3,0,10,0"/>
         <TextBox x:Name="Search" Grid.Column="1" MaxLength="256" MinHeight="33" AutomationProperties.Name="جستجو در این بخش" ToolTip="جستجوی نام، مقصد یا آدرس"/>
         <TextBlock x:Name="ResultCount" Grid.Column="2" Foreground="#ACAFBA" FontSize="11" VerticalAlignment="Center" Margin="12,0,2,0"/>
        </Grid><WrapPanel x:Name="Filters" Margin="0,6,0,0"/>
       </StackPanel>
      </Border>
      <StackPanel x:Name="Rows"/>
      <Border x:Name="EmptyPanel" Visibility="Collapsed" BorderBrush="#393B44" BorderThickness="1" Background="#202127" CornerRadius="12" Padding="24,28">
       <StackPanel HorizontalAlignment="Center"><Border Width="44" Height="44" CornerRadius="12" Background="#422B23" HorizontalAlignment="Center"><TextBlock x:Name="EmptyIcon" FontFamily="Segoe MDL2 Assets" FontSize="20" Foreground="#FF9568" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><TextBlock x:Name="EmptyTitle" TextAlignment="Center" TextWrapping="Wrap" FontSize="16" FontWeight="SemiBold" Margin="0,12,0,0"/><TextBlock x:Name="EmptyDetail" Foreground="{DynamicResource Muted}" TextAlignment="Center" TextWrapping="Wrap" FontSize="12" Margin="0,7,0,0" MaxWidth="500"/></StackPanel>
      </Border>
     </StackPanel>
    </ScrollViewer>
   </Grid>
   <Border Grid.Row="2" Background="#202127" BorderBrush="#393B43" BorderThickness="0,1,0,0" Padding="22,9">
    <DockPanel><TextBlock Text="&#xE946;" FontFamily="Segoe MDL2 Assets" Foreground="#F98B5E" Margin="0,2,8,0"/><TextBlock x:Name="Status" TextWrapping="Wrap" FontSize="11" Foreground="{DynamicResource Muted}" AutomationProperties.LiveSetting="Polite"/></DockPanel>
   </Border>
  </Grid>
 </Grid>
</Window>
